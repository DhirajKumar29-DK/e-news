# ==========================================
# Frontend Environment Configuration (.env.local)
# ==========================================

# 1. Local Development (Default):
# NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# 2. Production with Render:
# NEXT_PUBLIC_BACKEND_URL=https://e-news-backend.onrender.com
# NEXT_PUBLIC_API_URL=https://e-news-backend.onrender.com/api/v1

# 3. Production with Custom Domain (e.g. yourdomain.com):
# NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
